{
  "manifest_version": 3,
  "name": "Cerolingo",
  "author": "ancymon",
  "description": "Free, open-source Duolingo lesson automation and auto-solver extension",
  "version": "3.2.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "cerolingo@ancymon.dev",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["*://*.duolingo.com/*", "*://*.duolingo.cn/*"],
      "js": [
        "src/content/main.js",
        "src/content/solver.js",
        "src/content/bypass.js",
        "src/content/xp.js",
        "src/content/menu.js",
        "src/content/highlight.js"
      ],
      "css": ["src/styles/content.css"]
    },
    {
      "matches": ["*://*.duolingo.com/*", "*://*.duolingo.cn/*"],
      "js": ["src/content/challenges.js"],
      "world": "MAIN"
    },
    {
      "matches": ["*://*.duolingo.com/*", "*://*.duolingo.cn/*"],
      "js": ["src/content/audio.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "icons": {
    "512": "assets/icon.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "512": "assets/icon.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/title.svg"],
      "matches": ["*://*.duolingo.com/*", "*://*.duolingo.cn/*"]
    }
  ]
}
